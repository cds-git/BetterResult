<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0;net11.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <IsTestProject>false</IsTestProject>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>BetterResult</PackageId>
    <Version>4.0.0</Version>
    <Authors>cds</Authors>
    <PackageTags>Result;Error;ErrorHandling;Railway;Functional;Union</PackageTags>
    <Description>Errors as values for C#. A Result type with your own error types, railway operations, C# 15 union matching and an analyzer that flags discarded results. No dependencies, AOT compatible, netstandard2.0 for Unity.</Description>
    <PackageProjectUrl>https://github.com/cds-git/BetterResult</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/cds-git/BetterResult</RepositoryUrl>
    <PackageOutputPath>../artifacts/</PackageOutputPath>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../analyzers/BetterResult.Analyzers/BetterResult.Analyzers.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="Analyzer" PrivateAssets="all" />
    <None Include="../analyzers/BetterResult.Analyzers/bin/$(Configuration)/netstandard2.0/BetterResult.Analyzers.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
